# Copy to .env.local for local development.
# Only PUBLIC values belong here – every VITE_ variable ends up in the browser bundle.
# NEVER add a client secret. PKCE does not need one.

# Client ID from https://developer.spotify.com/dashboard (public, not a secret)
VITE_SPOTIFY_CLIENT_ID=

# Must match EXACTLY one Redirect URI registered in the Spotify dashboard.
# Local:      http://127.0.0.1:5173/callback
# Production: https://<your-project>.vercel.app/callback
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback
